{
  "name": "pandoc_markdown_inline",
  "rules": {
    "inline": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "_inline_element"
      }
    },
    "_inline_element": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "emphasis"
        },
        {
          "type": "SYMBOL",
          "name": "strong_emphasis"
        },
        {
          "type": "SYMBOL",
          "name": "code_span"
        },
        {
          "type": "SYMBOL",
          "name": "text"
        }
      ]
    },
    "emphasis": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PREC_LEFT",
          "value": 1,
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "*"
              },
              {
                "type": "REPEAT1",
                "content": {
                  "type": "SYMBOL",
                  "name": "_inline_no_star"
                }
              },
              {
                "type": "STRING",
                "value": "*"
              }
            ]
          }
        },
        {
          "type": "PREC_LEFT",
          "value": 1,
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "_"
              },
              {
                "type": "REPEAT1",
                "content": {
                  "type": "SYMBOL",
                  "name": "_inline_no_underscore"
                }
              },
              {
                "type": "STRING",
                "value": "_"
              }
            ]
          }
        }
      ]
    },
    "strong_emphasis": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PREC_LEFT",
          "value": 2,
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "**"
              },
              {
                "type": "REPEAT1",
                "content": {
                  "type": "SYMBOL",
                  "name": "_inline_element"
                }
              },
              {
                "type": "STRING",
                "value": "**"
              }
            ]
          }
        },
        {
          "type": "PREC_LEFT",
          "value": 2,
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "__"
              },
              {
                "type": "REPEAT1",
                "content": {
                  "type": "SYMBOL",
                  "name": "_inline_element"
                }
              },
              {
                "type": "STRING",
                "value": "__"
              }
            ]
          }
        }
      ]
    },
    "_inline_no_star": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "strong_emphasis"
        },
        {
          "type": "SYMBOL",
          "name": "code_span"
        },
        {
          "type": "SYMBOL",
          "name": "text"
        }
      ]
    },
    "_inline_no_underscore": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "strong_emphasis"
        },
        {
          "type": "SYMBOL",
          "name": "code_span"
        },
        {
          "type": "SYMBOL",
          "name": "text"
        }
      ]
    },
    "code_span": {
      "type": "PREC",
      "value": 3,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "`"
          },
          {
            "type": "FIELD",
            "name": "content",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "ALIAS",
                  "content": {
                    "type": "PATTERN",
                    "value": "[^`]+"
                  },
                  "named": true,
                  "value": "code_span_content"
                },
                {
                  "type": "BLANK"
                }
              ]
            }
          },
          {
            "type": "STRING",
            "value": "`"
          }
        ]
      }
    },
    "text": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "REPEAT1",
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "PATTERN",
              "value": "[^\\n\\r*_`\\[]+"
            },
            {
              "type": "PATTERN",
              "value": "[*_`]"
            }
          ]
        }
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": []
}
