    "code_span": {
      "type": "PREC",
      "value": 3,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "`"
          },
          {
            "type": "FIELD",
            "name": "content",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "ALIAS",
                  "content": {
                    "type": "PATTERN",
                    "value": "[^`]+"
                  },
                  "named": true,
                  "value": "code_span_content"
                },
                {
                  "type": "BLANK"
                }
              ]
            }
          },
          {
            "type": "STRING",
            "value": "`"
          }
        ]
      }
    },
    "autolink": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "<[^\\s<>]+:[^\\s<>]+>"
          },
          {
            "type": "PATTERN",
            "value": "<[A-Za-z0-9.!#$%&'*+\\/=?^_`{|}~-]+@[A-Za-z0-9.-]+>"
          }
        ]
      }
    },
    "html_inline": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "<\\/?[A-Za-z][^>\\r\\n]*>"
      }
    },
